{
  "name": "@lingcootech/frame-reference-system",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node --import tsx src/migrate.ts"
  },
  "dependencies": {
    "@lingcootech/frame": "^0.7.0",
    "@lingcootech/frame-cms": "^0.7.0",
    "@lingcootech/frame-extension-sdk": "^0.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.5.2",
    "eslint": "^10.8.0",
    "globals": "^16.0.0",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

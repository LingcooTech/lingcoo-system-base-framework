{
  "name": "@lingcootech/frame-example-extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Reference extension used to verify every Frame 0.7 runtime surface.",
  "files": [
    "dist",
    "migrations"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "import": "./dist/migrations.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@lingcootech/frame-admin": "^0.7.0",
    "@lingcootech/frame-extension-sdk": "^0.7.0",
    "@lingcootech/frame-web": "^0.7.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "eslint": "^10.8.0",
    "globals": "^16.0.0",
    "react": "^19.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

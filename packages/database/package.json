{
  "name": "@lingcootech/frame-database",
  "version": "0.7.2",
  "private": false,
  "type": "module",
  "description": "Database client, schema and migration runtime for Lingcoo Frame.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/LingcooTech/lingcoo-system-base-framework#readme",
  "bugs": {
    "url": "https://github.com/LingcooTech/lingcoo-system-base-framework/issues"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "import": "./dist/migrations.js"
    }
  },
  "bin": {
    "lingcoo-frame-migrate": "./dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node ../../scripts/copy-package-legal.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.20.4",
    "@types/semver": "^7.7.1",
    "eslint": "^10.8.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LingcooTech/lingcoo-system-base-framework.git"
  }
}

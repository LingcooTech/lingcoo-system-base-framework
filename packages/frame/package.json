{
  "name": "@lingcoo/frame",
  "version": "0.6.0",
  "private": false,
  "type": "module",
  "description": "Lingcoo Frame backend host, core modules and runtime composition.",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/host/app.d.ts",
      "import": "./dist/host/app.js"
    },
    "./env": {
      "types": "./dist/host/env.d.ts",
      "import": "./dist/host/env.js"
    },
    "./worker": {
      "types": "./dist/runtime/worker.d.ts",
      "import": "./dist/runtime/worker.js"
    },
    "./extensions": {
      "types": "./dist/core/extension.d.ts",
      "import": "./dist/core/extension.js"
    },
    "./manifest": {
      "types": "./dist/core/manifest.d.ts",
      "import": "./dist/core/manifest.js"
    },
    "./migrations": {
      "types": "./dist/runtime/migrations.d.ts",
      "import": "./dist/runtime/migrations.js"
    },
    "./cms": {
      "types": "./dist/integrations/cms/extension.d.ts",
      "import": "./dist/integrations/cms/extension.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --import tsx --test --test-concurrency=1 test/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^10.1.2",
    "@lingcoo/frame-database": "^0.6.0",
    "@lingcoo/frame-extension-sdk": "^0.6.0",
    "alipay-sdk": "^4.14.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "peerDependencies": {
    "@lingcoo/frame-cms": "^0.6.0"
  },
  "peerDependenciesMeta": {
    "@lingcoo/frame-cms": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lingcoo/frame-cms": "^0.6.0",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "eslint": "^10.8.0",
    "globals": "^16.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

{
  "name": "@lingcootech/frame",
  "version": "0.7.2",
  "private": false,
  "type": "module",
  "description": "Lingcoo Frame backend host, core modules and runtime composition.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/LingcooTech/lingcoo-system-base-framework#readme",
  "bugs": {
    "url": "https://github.com/LingcooTech/lingcoo-system-base-framework/issues"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/host/app.d.ts",
      "import": "./dist/host/app.js"
    },
    "./env": {
      "types": "./dist/host/env.d.ts",
      "import": "./dist/host/env.js"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js"
    },
    "./security": {
      "types": "./dist/security.d.ts",
      "import": "./dist/security.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js"
    },
    "./worker": {
      "types": "./dist/runtime/worker.d.ts",
      "import": "./dist/runtime/worker.js"
    },
    "./extensions": {
      "types": "./dist/core/extension.d.ts",
      "import": "./dist/core/extension.js"
    },
    "./manifest": {
      "types": "./dist/core/manifest.d.ts",
      "import": "./dist/core/manifest.js"
    },
    "./migrations": {
      "types": "./dist/runtime/migrations.d.ts",
      "import": "./dist/runtime/migrations.js"
    },
    "./cms": {
      "types": "./dist/integrations/cms/extension.d.ts",
      "import": "./dist/integrations/cms/extension.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node ../../scripts/copy-package-legal.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --import tsx --test --test-concurrency=1 test/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.7",
    "@fastify/static": "^10.1.7",
    "@lingcootech/frame-admin": "^0.7.2",
    "@lingcootech/frame-audit": "^0.7.2",
    "@lingcootech/frame-assets": "^0.7.2",
    "@lingcootech/frame-ai-openrouter": "^0.7.2",
    "@lingcootech/frame-database": "^0.7.2",
    "@lingcootech/frame-extension-sdk": "^0.7.2",
    "@lingcootech/frame-fastify": "^0.7.2",
    "@lingcootech/frame-identity": "^0.7.2",
    "@lingcootech/frame-integrations": "^0.7.2",
    "@lingcootech/frame-mail-nodemailer": "^0.7.2",
    "@lingcootech/frame-jobs": "^0.7.2",
    "@lingcootech/frame-kernel": "^0.7.2",
    "@lingcootech/frame-notifications": "^0.7.2",
    "@lingcootech/frame-presentation": "^0.7.2",
    "@lingcootech/frame-payments": "^0.7.2",
    "@lingcootech/frame-storage-qiniu": "^0.7.2",
    "@lingcootech/frame-web": "^0.7.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@lingcootech/frame-cms": "^0.7.2"
  },
  "peerDependenciesMeta": {
    "@lingcootech/frame-cms": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lingcootech/frame-cms": "^0.7.2",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "globals": "^16.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LingcooTech/lingcoo-system-base-framework.git"
  }
}

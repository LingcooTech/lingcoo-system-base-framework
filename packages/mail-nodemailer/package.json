{
  "name": "@lingcootech/frame-mail-nodemailer",
  "version": "0.7.2",
  "private": false,
  "type": "module",
  "description": "Nodemailer SMTP adapter for Lingcoo Frame Integrations.",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node ../../scripts/copy-package-legal.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@lingcootech/frame-fastify": "^0.7.2",
    "@lingcootech/frame-integrations": "^0.7.2",
    "fastify": "^5.11.3",
    "nodemailer": "^9.0.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^10.8.1",
    "globals": "^16.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LingcooTech/lingcoo-system-base-framework.git"
  }
}

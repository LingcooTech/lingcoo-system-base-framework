{
  "name": "@lingcootech/frame-extension-sdk",
  "version": "0.7.2",
  "private": false,
  "type": "module",
  "description": "Build-time extension and system composition contracts for Lingcoo Frame.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/LingcooTech/lingcoo-system-base-framework#readme",
  "bugs": {
    "url": "https://github.com/LingcooTech/lingcoo-system-base-framework/issues"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "import": "./dist/migrations.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node ../../scripts/copy-package-legal.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "semver": "^7.7.2"
  },
  "peerDependencies": {
    "@lingcootech/frame-database": "^0.7.2",
    "fastify": "^5.6.0"
  },
  "peerDependenciesMeta": {
    "@lingcootech/frame-database": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lingcootech/frame-database": "^0.7.2",
    "@types/node": "^24.5.2",
    "@types/semver": "^7.7.1",
    "eslint": "^10.8.0",
    "fastify": "^5.6.1",
    "globals": "^16.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LingcooTech/lingcoo-system-base-framework.git"
  }
}

{
  "$schema": "./docs/framework-manifest.schema.json",
  "name": "@lingcoo/frame",
  "version": "0.5.0",
  "kind": "runnable-base-framework",
  "origin": {
    "referenceProject": "lingcoo-edu-system",
    "strategy": "architecture extraction, not source mirroring"
  },
  "surfaces": ["public-web", "admin-ui", "api", "worker"],
  "infrastructure": ["postgresql", "docker", "caddy"],
  "foundationModules": [
    "system",
    "auth",
    "access",
    "settings",
    "audit",
    "metadata",
    "search",
    "data-exchange",
    "integrations",
    "jobs",
    "notifications",
    "assets",
    "presentation",
    "public-site",
    "observability"
  ],
  "firstPartyExtensions": ["frame-cms"],
  "domainModules": []
}
